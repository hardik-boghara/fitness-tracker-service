          },
          "role": {
            "type": "string"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "modifiedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponseUserDTO": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserDTO"
          }
        }
      },
      "ActivityLogDTO": {
        "required": [
          "activityDate",
          "activityDescription",
          "durationInMinutes",
          "userId",
          "workoutPlanId"
        ],
        "type": "object",
        "properties": {
