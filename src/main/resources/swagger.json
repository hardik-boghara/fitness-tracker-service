      "WorkoutPlanDTO": {
        "required": [
          "description",
          "durationInDays",
          "name",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationInDays": {
