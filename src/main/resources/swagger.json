            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ApiResponseWorkoutPlanDTO": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/WorkoutPlanDTO"
          }
        }
      },
      "UserDTO": {
        "required": [
          "email",
          "password",
          "role",
          "username"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
